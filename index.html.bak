  <section class="section" id="location">
    <div class="wedding-location-section reveal">
      <div class="location-card">
        <h2>Wedding Location</h2>
        <p class="location-name">St. Mary's Forane Church, Alakode</p>
        <div class="map-container">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d124772.35616785819!2d75.3402349805626!3d12.239060674060564!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3ba444f62d3232b3%3A0x7e5dd19498de1e1f!2sSt.%20Mary's%20Forane%20Church%2C%20Alakode!5e0!3m2!1sen!2sin!4v1785857544604!5m2!1sen!2sin"
            width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"></iframe>
        </div>
        <div class="location-actions">
          <div class="qr-box">
            <img src="qr.PNG" alt="Location QR Code" class="qr-image">
            <span>Scan to Navigate</span>
