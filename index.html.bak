<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <!-- Optimized viewport for standard responsive rendering across mobile devices -->
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=3.0, user-scalable=yes">
  <title>Theres &amp; Midhun — Our Wedding</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Great+Vibes&family=Marck+Script&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Jost:wght@300;400;500;600;700&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
  <style>
    :root {
      --powder-deep: #7FA8C9;
      --powder: #AFCBDD;
      --powder-pale: #E7F1F7;
      --cream: #FBF7EF;
      --ink: #223A4D;
      --ink-soft: #51697c;
      --gold: #C6A15B;
      --blush: #E7CFC1;
      --white: #ffffff;
      --shadow: 0 20px 50px -20px rgba(34, 58, 77, 0.25);
      --ease: cubic-bezier(.22, 1, .36, 1);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Jost', sans-serif;
      background: var(--cream);
      color: var(--ink-soft);
      overflow-x: hidden;
      line-height: 1.6;
    }

    img {
      max-width: 100%;
      display: block;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    h1,
    h2,
    h3 {
      font-family: 'Playfair Display', serif;
      color: var(--ink);
      font-weight: 600;
    }

    .script {
      font-family: 'Marck Script', cursive;
      font-weight: 400;
    }

    .eyebrow {
      font-family: 'Jost', sans-serif;
      letter-spacing: .28em;
      text-transform: uppercase;
      font-size: .72rem;
      color: #08090a;
      font-weight: 600;
    }

    .section {
      position: relative;
      padding: 110px 6vw;
      max-width: 1280px;
      margin: 0 auto;
      overflow: hidden;
    }

    /* ============ DYNAMIC BRANCHES ============ */
    .section-branch {
      position: absolute;
      top: 0;
      width: 250px;
      height: 250px;
      background-image: url('home.jpg');
      background-size: 900px auto;
      background-repeat: no-repeat;
      mix-blend-mode: multiply;
      opacity: 0.85;
      z-index: 0;
      pointer-events: none;
    }

    .section-branch.left {
      left: 0;
      background-position: top left;
      -webkit-mask-image: radial-gradient(circle at top left, black 40%, transparent 70%);
      mask-image: radial-gradient(circle at top left, black 40%, transparent 70%);
    }

    .section-branch.right {
      right: 0;
      background-position: top left;
      transform: scaleX(-1);
      -webkit-mask-image: radial-gradient(circle at top left, black 40%, transparent 70%);
      mask-image: radial-gradient(circle at top left, black 40%, transparent 70%);
    }

    .section-head,
    .countdown,
    .photo-grid,
    .masonry,
    .story-line,
    .video-grid,
    .roadmap-container,
    .family-cols,
    .wishes-wrap,
    .loc-wrap,
    .flipbook {
      position: relative;
      z-index: 1;
    }

    .section-head {
      text-align: center;
      max-width: 640px;
      margin: 0 auto 60px;
    }

    .section-head h2 {
      font-size: clamp(2rem, 4vw, 3rem);
      margin-top: 10px;
    }

    .section-head p {
      margin-top: 14px;
      font-size: 1.02rem;
    }

    .reveal {
      opacity: 0;
      transform: translateY(36px);
      transition: opacity .9s var(--ease), transform .9s var(--ease);
    }

    .reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    .wave {
      display: block;
      width: 100%;
      line-height: 0;
    }

    .wave svg {
      width: 100%;
      height: 70px;
      display: block;
    }

    /* ============ NAV ============ */
    header.nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 500;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 22px 5vw;
      transition: background .4s var(--ease), padding .4s var(--ease), box-shadow .4s var(--ease);
    }

    header.nav.scrolled {
      background: rgba(242, 245, 248, 0.92);
      backdrop-filter: blur(10px);
      padding: 14px 5vw;
      box-shadow: 0 6px 24px -12px rgba(34, 58, 77, .25);
    }

    .nav-mark {
      font-family: 'Marck Script', cursive;
      font-size: 1.5rem;
      color: var(--ink);
    }

    .nav-links {
      display: flex;
      gap: 28px;
      list-style: none;
    }

    .nav-links a {
      font-size: .78rem;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: var(--ink);
      font-weight: 600;
      position: relative;
      padding-bottom: 4px;
      text-shadow: 0px 1px 3px rgba(255, 255, 255, 0.8), 0px 0px 5px rgba(226, 238, 245, 0.5);
    }

    .nav-links a::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: 0;
      height: 1px;
      width: 0;
      background: var(--ink);
      transition: width .35s var(--ease);
    }

    .nav-links a:hover::after,
    .nav-links a.active::after {
      width: 100%;
    }

    .nav-links a.active {
      color: var(--ink);
    }

    .burger {
      display: none;
    }

    .dot-nav {
      position: fixed;
      right: 26px;
      top: 50%;
      transform: translateY(-50%);
      z-index: 400;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .dot-nav a {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      border: 1px solid var(--powder-deep);
      display: block;
      position: relative;
    }

    .dot-nav a.active {
      background: var(--gold);
      border-color: var(--gold);
    }

    .dot-nav a .tip {
      position: absolute;
      right: 20px;
      top: 50%;
      transform: translateY(-50%);
      white-space: nowrap;
      font-size: .7rem;
      letter-spacing: .1em;
      text-transform: uppercase;
      background: var(--ink);
      color: var(--cream);
      padding: 4px 10px;
      border-radius: 4px;
      opacity: 0;
      pointer-events: none;
      transition: opacity .25s;
    }

    .dot-nav a:hover .tip {
      opacity: 1;
    }

    /* ============ HERO ============ */
    #home {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      position: relative;
      padding: 120px 6vw;
      overflow: hidden;
      background-color: var(--cream);
    }

    .hero-scene {
      position: absolute;
      inset: 0;
      height: 100%;
      background: url('home.jpg') bottom center / cover no-repeat;
      opacity: 1;
      z-index: 1;
      pointer-events: none;
    }

    .shimmer-field {
      position: absolute;
      inset: 0;
      pointer-events: none;
      overflow: hidden;
      z-index: 2;
    }

    .snowflake {
      position: absolute;
      top: -60px;
      color: rgba(255, 255, 255, 0.85);
      font-size: 16px;
      line-height: 1;
      pointer-events: none;
      user-select: none;
      text-shadow:
        0 0 6px rgba(255, 255, 255, 0.6),
        0 0 12px rgba(198, 161, 91, 0.15);
      animation: snowFall linear infinite, snowSway ease-in-out infinite;
      will-change: transform, opacity;
    }

    @keyframes snowFall {
      0% {
        transform: translateY(0) rotate(0deg);
        opacity: 0;
      }
      5% {
        opacity: var(--snow-opacity, 0.8);
      }
      90% {
        opacity: var(--snow-opacity, 0.8);
      }
      100% {
        transform: translateY(110vh) rotate(360deg);
        opacity: 0;
      }
    }

    @keyframes snowSway {
      0%, 100% {
        margin-left: 0;
      }
      25% {
        margin-left: 15px;
      }
      50% {
        margin-left: -10px;
      }
      75% {
        margin-left: 20px;
      }
    }

    .hero-inner,
    .scroll-cue {
      position: relative;
      z-index: 4;
    }

    .hero-inner {
      max-width: 860px;
      position: relative;
      padding: clamp(20px, 4vw, 40px) 16px;
      background: transparent !important;
      border: none !important;
      box-shadow: none !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
    }

    .hero-monogram-badge {
      display: flex;
      justify-content: center;
      margin-bottom: 12px;
    }

    .hero-crest-svg {
      width: 100px;
      height: 26px;
      filter: drop-shadow(0 1px 6px rgba(255, 255, 255, 0.95)) drop-shadow(0 2px 8px rgba(198, 161, 91, 0.5));
    }

    .hero-inner .eyebrow {
      display: block;
      margin-bottom: 14px;
      letter-spacing: .35em;
      font-size: .82rem;
      font-weight: 600;
      color: #1a354b;
      text-transform: uppercase;
      text-shadow: 0 1px 10px rgba(255, 255, 255, 0.95), 0 0 18px rgba(255, 255, 255, 0.85);
    }

    .hero-names {
      font-family: 'Great Vibes', 'Alex Brush', 'Marck Script', cursive;
      font-style: normal;
      font-weight: 400;
      font-size: clamp(4.4rem, 11vw, 8rem);
      color: #142e42;
      line-height: 1.18;
      letter-spacing: 0.01em;
      text-shadow:
        0 0 25px rgba(255, 255, 255, 0.95),
        0 2px 10px rgba(255, 255, 255, 0.9),
        0 4px 22px rgba(198, 161, 91, 0.35),
        0 2px 6px rgba(18, 40, 58, 0.25);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 0.08em 0.28em;
    }

    .hero-name-item {
      display: inline-block;
      transition: transform 0.3s ease;
    }

    .hero-name-item:hover {
      transform: translateY(-2px);
    }

    .hero-amp-container {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      position: relative;
      margin: 0 0.12em;
    }

    .hero-amp {
      font-family: 'Playfair Display', serif;
      font-style: italic;
      font-weight: 500;
      font-size: clamp(2.6rem, 7vw, 4.6rem);
      line-height: 1;
      background: linear-gradient(135deg, #ECC880 0%, #C6A15B 50%, #9e7529 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 2px 8px rgba(255, 255, 255, 0.95)) drop-shadow(0 2px 10px rgba(198, 161, 91, 0.6));
      transform: translateY(-2px);
    }

    .hero-tagline-container {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 16px;
      margin-top: 12px;
    }

    .tagline-ornament {
      height: 1px;
      width: clamp(28px, 6vw, 60px);
      background: linear-gradient(90deg, transparent, var(--gold), transparent);
    }

    .hero-tagline {
      margin: 0;
      font-family: 'Playfair Display', serif;
      font-style: italic;
      font-weight: 600;
      font-size: clamp(1.2rem, 2.3vw, 1.5rem);
      color: #1a354b;
      letter-spacing: 0.08em;
      text-shadow: 0 1px 12px rgba(255, 255, 255, 0.95), 0 0 20px rgba(255, 255, 255, 0.85);
    }

    .hero-divider {
      display: none;
    }

    .hero-date-block {
      text-align: center;
      background: transparent !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
      border: none !important;
      box-shadow: none !important;
      padding: 10px 20px;
      margin: 18px auto 0;
      max-width: 500px;
    }

    .hero-date-big {
      font-family: 'Playfair Display', serif;
      font-weight: 600;
      font-size: clamp(1.2rem, 2.4vw, 1.55rem);
      letter-spacing: .15em;
      color: #142e42;
      text-transform: uppercase;
      text-shadow: 0 1px 12px rgba(255, 255, 255, 0.95), 0 0 20px rgba(255, 255, 255, 0.85);
    }

    .hero-venue {
      margin-top: 6px;
      font-family: 'Jost', sans-serif;
      font-weight: 500;
      font-size: .95rem;
      letter-spacing: .05em;
      color: #1a354b;
      text-shadow: 0 1px 10px rgba(255, 255, 255, 0.95), 0 0 16px rgba(255, 255, 255, 0.85);
    }

    .hero-cta {
      display: inline-block;
      margin-top: 38px;
      padding: 16px 40px;
      border-radius: 40px;
      background: rgba(255, 255, 255, .75);
      border: 1px solid rgba(255, 255, 255, .9);
      backdrop-filter: blur(6px);
      font-family: 'Jost', sans-serif;
      font-weight: 600;
      font-size: .82rem;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--ink);
      box-shadow: 0 12px 30px -14px rgba(34, 58, 77, .35);
      transition: background .3s, transform .3s;
    }

    .hero-cta:hover {
      background: rgba(255, 255, 255, 1);
      transform: translateY(-2px);
    }

    .scroll-cue {
      position: absolute;
      bottom: 30px;
      left: 50%;
      transform: translateX(-50%);
      font-size: .7rem;
      letter-spacing: .2em;
      text-transform: uppercase;
      color: var(--powder-deep);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
    }

    .scroll-cue .line {
      width: 1px;
      height: 34px;
      background: var(--powder-deep);
      animation: pulseLine 2s ease-in-out infinite;
    }

    @keyframes pulseLine {

      0%,
      100% {
        opacity: .2;
      }

      50% {
        opacity: 1;
      }
    }

    /* ============ OTHER SECTIONS ============ */
    #save-the-date {
      background: var(--white);
    }

    .countdown {
      display: flex;
      justify-content: center;
      gap: 22px;
      flex-wrap: wrap;
      margin-bottom: 60px;
    }

    .count-box {
      background: var(--powder-pale);
      border-radius: 10px;
      width: 110px;
      padding: 22px 0;
      text-align: center;
      box-shadow: var(--shadow);
    }

    .count-box .num {
      font-family: 'Playfair Display', serif;
      font-size: 2.3rem;
      color: var(--ink);
    }

    .count-box .lbl {
      font-size: .68rem;
      letter-spacing: .18em;
      text-transform: uppercase;
      color: var(--powder-deep);
      margin-top: 6px;
    }

    .photo-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
    }

    .photo-grid .ph {
      border-radius: 10px;
      overflow: hidden;
      position: relative;
      aspect-ratio: 3/4;
      cursor: pointer;
      box-shadow: var(--shadow);
      background: var(--powder-pale);
    }

    .photo-grid .ph:nth-child(2) {
      aspect-ratio: 3/4;
      margin-top: 34px;
    }

    .photo-grid .ph:nth-child(4) {
      margin-top: -34px;
    }

    .photo-grid img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform .6s var(--ease);
    }

    .photo-grid .ph:hover img {
      transform: scale(1.08);
    }

    .photo-grid .ph .cap {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 14px;
      background: linear-gradient(0deg, rgba(34, 58, 77, .65), transparent);
      color: #fff;
      font-size: .75rem;
      letter-spacing: .08em;
      text-transform: uppercase;
      opacity: 0;
      transition: opacity .35s;
    }

    .photo-grid .ph:hover .cap {
      opacity: 1;
    }

    #engagement {
      background: var(--powder-pale);
    }

    .masonry {
      columns: 4 220px;
      column-gap: 18px;
    }

    .masonry .m-item {
      break-inside: avoid;
      margin-bottom: 18px;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: var(--shadow);
      cursor: pointer;
      position: relative;
    }

    .masonry img {
      width: 100%;
      transition: transform .6s var(--ease);
    }

    .masonry .m-item:hover img {
      transform: scale(1.06);
    }

    .lightbox {
      position: fixed;
      inset: 0;
      background: rgba(20, 32, 42, .92);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      padding: 40px;
    }

    .lightbox.open {
      display: flex;
    }

    .lightbox img {
      max-width: 90vw;
      max-height: 85vh;
      border-radius: 6px;
    }

    .lightbox .close {
      position: absolute;
      top: 26px;
      right: 34px;
      color: #fff;
      font-size: 2rem;
      cursor: pointer;
      font-family: 'Playfair Display', serif;
    }

    #story {
      background: var(--cream);
    }

    .story-line {
      position: relative;
      max-width: 720px;
      margin: 0 auto;
    }

    .story-line::before {
      content: "";
      position: absolute;
      left: 20px;
      top: 0;
      bottom: 0;
      width: 1px;
      background: var(--powder);
    }

    .story-item {
      position: relative;
      padding-left: 64px;
      margin-bottom: 56px;
    }

    .story-item:last-child {
      margin-bottom: 0;
    }

    .story-item .dot {
      position: absolute;
      left: 12px;
      top: 4px;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: var(--white);
      border: 2px solid var(--gold);
    }

    .story-item .story-eyebrow {
      display: block;
      margin-bottom: 8px;
    }

    .story-item h3 {
      font-size: 1.35rem;
      margin-bottom: 8px;
    }

    .story-item p {
      font-size: .98rem;
      max-width: 560px;
    }

    #videos {
      background: var(--powder-pale);
    }

    #journey {
      background: var(--white);
      position: relative;
    }

    .roadmap-container {
      max-width: 1100px;
      margin: 50px auto 0;
      position: relative;
      padding: 0 20px;
    }

    .roadmap-line-bg {
      position: absolute;
      top: 30px;
      left: 50px;
      right: 50px;
      height: 2px;
      background: rgba(175, 203, 221, 0.3);
      z-index: 1;
    }

    .roadmap-line-progress {
      position: absolute;
      top: 0;
      left: 0;
      height: 100%;
      width: 0%;
      background: var(--gold);
      transition: width 1.2s cubic-bezier(.22, 1, .36, 1);
    }

    .roadmap {
      display: flex;
      justify-content: space-between;
      position: relative;
      z-index: 2;
      gap: 20px;
    }

    .rm-step {
      flex: 1;
      text-align: center;
      position: relative;
      transition: all 0.4s var(--ease);
    }

    .rm-num {
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: var(--white);
      border: 2px solid var(--powder);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 24px;
      font-family: 'Playfair Display', serif;
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--ink-soft);
      position: relative;
      z-index: 3;
      transition: all 0.4s ease;
      box-shadow: 0 0 0 4px var(--white);
    }

    .rm-step h3 {
      font-size: 1.1rem;
      margin-bottom: 6px;
      transition: all 0.4s ease;
      color: var(--ink);
      display: inline-block;
      position: relative;
    }

    .rm-step .rm-date {
      font-size: .78rem;
      color: var(--powder-deep);
      letter-spacing: .1em;
      text-transform: uppercase;
      margin-bottom: 10px;
      font-weight: 600;
      transition: all 0.4s ease;
      position: relative;
    }

    .rm-step p {
      font-size: .88rem;
      color: var(--ink-soft);
      padding: 0 8px;
      transition: opacity 0.4s ease;
    }

    .rm-step.completed .rm-num {
      border-color: var(--gold);
      background: var(--cream);
      color: var(--gold);
      box-shadow: 0 0 15px rgba(198, 161, 91, 0.2), 0 0 0 4px var(--white);
    }

    .rm-step.completed h3,
    .rm-step.completed .rm-date {
      color: #a0b0be;
    }

    .rm-step.completed h3::after,
    .rm-step.completed .rm-date::after {
      content: "";
      position: absolute;
      left: 0;
      top: 50%;
      width: 100%;
      height: 1px;
      background: rgba(160, 176, 190, 0.6);
      transform: scaleX(1);
      transform-origin: left;
      transition: transform 0.5s ease;
    }

    .rm-step.completed p {
      opacity: 0.6;
    }

    #family {
      background: var(--powder-pale);
    }

    .family-cols {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 50px;
    }

    .family-card {
      background: var(--white);
      border-radius: 14px;
      padding: 40px 34px;
      box-shadow: var(--shadow);
    }

    .family-card h3 {
      text-align: center;
      font-size: 1.3rem;
      margin-bottom: 6px;
    }

    .family-card .sub {
      text-align: center;
      display: block;
      margin-bottom: 26px;
    }

    .member {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 14px 0;
      border-bottom: 1px solid var(--powder-pale);
    }

    .member:last-child {
      border-bottom: none;
    }

    .avatar {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--powder), var(--blush));
      flex-shrink: 0;
    }

    .member .m-name {
      font-family: 'Playfair Display', serif;
      color: var(--ink);
      font-size: 1rem;
    }

    .member .m-rel {
      font-size: .75rem;
      color: var(--powder-deep);
      letter-spacing: .05em;
      text-transform: uppercase;
    }

    #wishes {
      background: var(--white);
    }

    .wishes-wrap {
      max-width: 640px;
      margin: 0 auto;
    }

    .wish-form {
      background: var(--powder-pale);
      border-radius: 14px;
      padding: 36px;
      box-shadow: var(--shadow);
      display: flex;
      flex-direction: column;
      gap: 16px;
      margin-bottom: 50px;
    }

    .wish-form input,
    .wish-form textarea {
      font-family: 'Jost', sans-serif;
      font-size: .95rem;
      border: 1px solid var(--powder);
      background: var(--white);
      border-radius: 8px;
      padding: 13px 16px;
      color: var(--ink);
      resize: vertical;
    }

    .wish-form input:focus,
    .wish-form textarea:focus {
      outline: none;
      border-color: var(--gold);
    }

    .wish-form textarea {
      min-height: 110px;
    }

    .wish-form .btn {
      align-self: center;
      margin-top: 4px;
    }

    #wishThanks {
      display: none;
      text-align: center;
      color: var(--powder-deep);
      font-size: .9rem;
      margin-top: -6px;
    }

    #wishThanks.show {
      display: block;
    }

    .wish-list {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .wish-card {
      background: var(--powder-pale);
      border-left: 3px solid var(--gold);
      border-radius: 8px;
      padding: 18px 22px;
    }

    .wish-card .w-name {
      font-family: 'Playfair Display', serif;
      color: var(--ink);
      font-size: 1rem;
      margin-bottom: 4px;
    }

    .wish-card .w-msg {
      font-size: .9rem;
    }

    .wish-empty {
      text-align: center;
      font-size: .85rem;
      opacity: .6;
    }

    #location {
      background: var(--cream);
    }

    .wedding-location-section {
      display: flex;
      justify-content: center;
      padding: 40px 20px;
      background-color: #faf9f6;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .location-card {
      background: #ffffff;
      padding: 30px;
      border-radius: 12px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      max-width: 500px;
      width: 100%;
      text-align: center;
    }

    .location-card h2 {
      color: #2c3e50;
      margin-bottom: 8px;
      font-size: 26px;
    }

    .location-name {
      color: #7f8c8d;
      font-size: 16px;
      margin-bottom: 20px;
    }

    .map-container {
      width: 100%;
      height: 250px;
      border-radius: 8px;
      overflow: hidden;
      margin-bottom: 20px;
      box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.05);
    }

    .location-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-top: 15px;
      text-align: left;
    }

    .qr-box {
      display: flex;
      flex-direction: column;
      align-items: center;
      font-size: 12px;
      color: #666;
    }

    .qr-image {
      width: 100px;
      height: 100px;
      border-radius: 6px;
      border: 1px solid #ddd;
      margin-bottom: 5px;
    }

    .link-box {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .link-box p {
      font-size: 13px;
      color: #555;
      margin-bottom: 12px;
    }

    .map-btn {
      display: inline-block;
      background-color: #3498db;
      color: #ffffff;
      padding: 10px 18px;
      border-radius: 6px;
      text-decoration: none;
      font-weight: 600;
      font-size: 14px;
      text-align: center;
      transition: background-color 0.2s ease;
    }

    .map-btn:hover {
      background-color: #2980b9;
    }

    .insta-reels-container {
      display: flex;
      gap: 20px;
      justify-content: center;
      align-items: center;
      width: 100%;
      max-width: 1100px;
      margin: 0 auto;
      padding: 20px;
    }

    .insta-card {
      position: relative;
      width: 100%;
      max-width: 270px;
      aspect-ratio: 9 / 16;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
      cursor: pointer;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      background: #000;
    }

    .insta-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.35);
    }

    .insta-card video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .insta-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom,
          rgba(0, 0, 0, 0.4) 0%,
          transparent 35%,
          rgba(0, 0, 0, 0.75) 100%);
      pointer-events: none;
    }

    .insta-badge {
      position: absolute;
      top: 15px;
      left: 15px;
      background: rgba(255, 255, 255, 0.2);
      backdrop-filter: blur(8px);
      color: #fff;
      font-size: 11px;
      font-weight: 600;
      padding: 5px 12px;
      border-radius: 20px;
      border: 1px solid rgba(255, 255, 255, 0.3);
    }

    .insta-sound-btn {
      position: absolute;
      top: 15px;
      right: 15px;
      background: rgba(0, 0, 0, 0.5);
      backdrop-filter: blur(6px);
      border: 1px solid rgba(255, 255, 255, 0.3);
      color: #fff;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background 0.2s ease;
      z-index: 3;
    }

    .insta-sound-btn:hover {
      background: rgba(0, 0, 0, 0.8);
    }

    .insta-title {
      position: absolute;
      bottom: 20px;
      left: 20px;
      right: 20px;
      color: #fff;
      font-size: 15px;
      font-weight: 600;
      text-shadow: 0 2px 4px rgba(0, 0, 0, 0.6);
      z-index: 2;
    }

    .insta-modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(10px);
      z-index: 9999;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }

    .insta-modal-content {
      position: relative;
      background: #111;
      padding: 20px;
      border-radius: 24px;
      max-width: 400px;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    }

    .insta-modal-content video {
      width: 100%;
      aspect-ratio: 9 / 16;
      border-radius: 16px;
      object-fit: cover;
    }

    .insta-modal-content h3 {
      color: #fff;
      margin-top: 15px;
      font-size: 18px;
      font-weight: 600;
    }

    .insta-close-btn {
      position: absolute;
      top: 10px;
      right: 15px;
      color: #aaa;
      font-size: 32px;
      font-weight: bold;
      cursor: pointer;
      transition: color 0.2s;
    }

    .insta-close-btn:hover {
      color: #fff;
    }

    .story-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 50px;
      align-items: center;
    }

    .story-img-wrapper {
      position: relative;
      padding: 15px;
      border: 1px solid var(--accent-warm, #C6A15B);
    }

    .story-img-wrapper img {
      width: 100%;
      height: 480px;
      object-fit: cover;
      display: block;
    }

    .story-text {
      padding: 20px 0;
    }

    .story-text h3 {
      font-family: 'Playfair Display', serif;
      font-size: 2rem;
      margin-bottom: 15px;
      color: var(--ink);
    }

    .story-text p {
      margin-bottom: 20px;
      color: var(--ink-soft);
      font-size: 1.05rem;
      line-height: 1.6;
    }

    #gallery {
      background: var(--powder-pale);
    }

    .flipbook {
      max-width: 480px;
      margin: 0 auto;
      text-align: center;
    }

    .flip-stage {
      position: relative;
      width: 100%;
      aspect-ratio: 3/4;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: var(--shadow);
      perspective: 1600px;
      background: var(--white);
    }

    .flip-stage img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transform-origin: left center;
      transition: transform .45s ease-in, opacity .45s ease-in;
      backface-visibility: hidden;
    }

    .flip-stage img.turning {
      transform: rotateY(-100deg);
      opacity: .2;
    }

    .flip-count {
      position: absolute;
      bottom: 14px;
      right: 16px;
      background: rgba(34, 58, 77, .65);
      color: #fff;
      font-size: .72rem;
      letter-spacing: .08em;
      padding: 5px 12px;
      border-radius: 20px;
    }

    .flip-controls {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 16px;
      margin-top: 28px;
    }

    .flip-btn {
      border: none;
      cursor: pointer;
      font-family: 'Jost', sans-serif;
      letter-spacing: .08em;
      text-transform: uppercase;
      font-size: .8rem;
      transition: background .3s, transform .2s;
    }

    .flip-btn.next {
      background: var(--ink);
      color: var(--cream);
      padding: 13px 28px;
      border-radius: 30px;
    }

    .flip-btn.next:hover {
      background: var(--powder-deep);
      transform: translateX(2px);
    }

    .flip-btn.prev {
      background: transparent;
      border: 1px solid var(--powder-deep);
      color: var(--ink);
      width: 44px;
      height: 44px;
      padding: 0;
      border-radius: 50%;
      font-size: 1.1rem;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .flip-btn.prev:hover {
      background: var(--white);
    }

    .music-player-btn {
      position: fixed;
      bottom: 25px;
      left: 25px;
      width: 50px;
      height: 50px;
      background: var(--white);
      border: 1px solid var(--powder);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
      cursor: pointer;
      z-index: 1500;
      transition: all 0.3s ease;
    }

    .music-player-btn:hover {
      transform: scale(1.08);
      border-color: var(--gold);
    }

    .music-player-btn svg {
      width: 22px;
      height: 22px;
      fill: var(--ink);
      transition: fill 0.3s ease;
    }

    .music-player-btn.playing {
      border-color: var(--gold);
      animation: pulseGlow 2s infinite alternate;
    }

    @keyframes pulseGlow {
      0% {
        box-shadow: 0 0 5px rgba(198, 161, 91, 0.3);
      }

      100% {
        box-shadow: 0 0 18px rgba(198, 161, 91, 0.7);
      }
    }

    footer {
      text-align: center;
      padding: 70px 6vw 50px;
      background: var(--ink);
      color: var(--powder-pale);
    }

    footer .script {
      font-size: 2.4rem;
      color: var(--white);
    }

    footer p {
      margin-top: 14px;
      font-size: .85rem;
      opacity: .75;
    }
  </style>
