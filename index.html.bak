  <section class="section" id="wishes">
    <div class="section-branch left"></div>
    <div class="section-branch right"></div>
    <div class="section-head reveal">
      <h2>Leave Your Wishes</h2>
    </div>
    <div class="wishes-wrap reveal">
      <form class="wish-form" id="wishForm"
        action="https://docs.google.com/forms/u/1/d/e/1FAIpQLScFDfgZKJ74I1vgkjwp6_a2VTOBIQIJeoibeVxrK_rSqhZRMw/formResponse?pli=1"
        method="POST" target="gform_silent_target">
        <input type="hidden" name="fvv" value="1">
        <input type="hidden" name="pageHistory" value="0">
        <input type="hidden" name="fbzx" value="4040917774078391540">
        <input type="text" name="entry.1038824486" id="wishName" placeholder="Your name" required autocomplete="name">
        <textarea name="entry.1886068785" id="wishText" placeholder="Write your warm wishes &amp; blessings..."
          required></textarea>
        <button type="submit" class="btn" id="wishSubmitBtn">Send Wishes</button>
      </form>
      <iframe name="gform_silent_target" id="gform_silent_target" style="display:none;" aria-hidden="true"></iframe>
      <div class="wish-list" id="wishList"></div>
    </div>
  </section>
  <section class="section" id="gallery">
    <div class="section-branch left"></div>
    <div class="section-branch right"></div>
    <div class="section-head reveal">
      <span class="eyebrow">Captured Moments</span>
      <h2>Our Photo Gallery</h2>
      <p>Flip through some of our favorite memories together.</p>
    </div>
    <div class="flipbook reveal">
      <div class="flip-stage">
        <img id="flipImg" src="car.jpeg" alt="Gallery photo" loading="lazy">
        <div class="flip-count" id="flipCount">1 / 9</div>
      </div>
      <div class="flip-controls">
        <button class="flip-btn prev" id="prevPhoto" aria-label="Previous Photo">&#8249;</button>
        <button class="flip-btn next" id="nextPhoto">Next Photo &#8250;</button>
      </div>
    </div>
  </section>
  <div class="music-player-btn" id="musicBtn" onclick="toggleMusic()" aria-label="Toggle Background Music">
    <svg id="playIcon" viewBox="0 0 24 24">
      <path d="M8 5v14l11-7z" />
    </svg>
    <svg id="pauseIcon" viewBox="0 0 24 24" style="display: none;">
      <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
    </svg>
  </div>

  <audio id="bgMusic" loop>
    <source src="whatsap.mp3" type="audio/mpeg">
    Your browser does not support the audio element.
  </audio>

  <footer>
    <div class="script">Theres &amp; Midhun</div>
  </footer>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
  <script>
    const bgMusic = document.getElementById('bgMusic');
    const musicBtn = document.getElementById('musicBtn');
    const playIcon = document.getElementById('playIcon');
    const pauseIcon = document.getElementById('pauseIcon');

    function updateMusicButtonState() {
      if (!bgMusic || !musicBtn) return;
      if (bgMusic.paused) {
        musicBtn.classList.remove('playing');
        if (playIcon) playIcon.style.display = 'block';
        if (pauseIcon) pauseIcon.style.display = 'none';
        musicBtn.setAttribute('aria-label', 'Play Background Music');
        musicBtn.setAttribute('title', 'Play Music');
      } else {
        musicBtn.classList.add('playing');
        if (playIcon) playIcon.style.display = 'none';
        if (pauseIcon) pauseIcon.style.display = 'block';
        musicBtn.setAttribute('aria-label', 'Pause Background Music');
        musicBtn.setAttribute('title', 'Pause Music');
      }
    }

    function toggleMusic() {
      if (!bgMusic) return;
      if (bgMusic.paused) {
        bgMusic.play().then(() => {
          updateMusicButtonState();
        }).catch(error => {
          console.log("Audio playback prevented:", error);
        });
      } else {
        bgMusic.pause();
        updateMusicButtonState();
      }
    }

    if (bgMusic) {
      bgMusic.addEventListener('play', updateMusicButtonState);
      bgMusic.addEventListener('pause', updateMusicButtonState);
    }

    const WEDDING = {
      weddingDateISO: "2026-11-21T10:00:00",
      venueLat: 11.8745,
      venueLng: 75.3704,
    };

    const shimmerField = document.getElementById('shimmerField');
    if (shimmerField) {
      const snowChars = ['❄', '❅', '❆', '✦', '✧', '•'];
      for (let i = 0; i < 60; i++) {
        const flake = document.createElement('div');
        flake.className = 'snowflake';
        flake.textContent = snowChars[Math.floor(Math.random() * snowChars.length)];
        flake.style.left = (Math.random() * 100) + 'vw';
        const size = 8 + Math.random() * 18;
        flake.style.fontSize = size + 'px';
        const opacity = 0.3 + Math.random() * 0.6;
        flake.style.setProperty('--snow-opacity', opacity);
        const fallDuration = 15 + Math.random() * 25;
        const swayDuration = 3 + Math.random() * 4;
        flake.style.animationDuration = fallDuration + 's, ' + swayDuration + 's';
        flake.style.animationDelay = (Math.random() * -30) + 's, ' + (Math.random() * -5) + 's';
        shimmerField.appendChild(flake);
      }
    }

    const roadmapSteps = document.querySelectorAll('#roadmap .rm-step');
    const roadmapProgress = document.getElementById('roadmapProgress');
    const today = new Date(); today.setHours(0, 0, 0, 0);
    let completedCount = 0;
    roadmapSteps.forEach(step => {
      const eventDate = new Date(step.dataset.date); eventDate.setHours(0, 0, 0, 0);
      if (eventDate < today) { step.classList.add('completed'); completedCount++; }
    });
    if (roadmapSteps.length > 1) {
      const progressPercentage = completedCount > 0 ? (completedCount / roadmapSteps.length) * 100 : 0;
      setTimeout(() => {
        roadmapProgress.style.width = `${progressPercentage}%`;
      }, 400);
    }

    const weddingDate = new Date(WEDDING.weddingDateISO).getTime();
    function updateCountdown() {
      const diff = Math.max(0, weddingDate - Date.now());
      document.getElementById('cd-days').textContent = String(Math.floor(diff / 86400000)).padStart(2, '0');
      document.getElementById('cd-hours').textContent = String(Math.floor((diff % 86400000) / 3600000)).padStart(2, '0');
      document.getElementById('cd-mins').textContent = String(Math.floor((diff % 3600000) / 60000)).padStart(2, '0');
      document.getElementById('cd-secs').textContent = String(Math.floor((diff % 60000) / 1000)).padStart(2, '0');
    }
    updateCountdown(); setInterval(updateCountdown, 1000);

    const io = new IntersectionObserver((entries) => { entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('is-visible'); }); }, { threshold: 0.15 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));

  </script>
  <script>
    /* ============ FLIPBOOK GALLERY LOGIC ============ */
    const galleryImages = [
      'car.jpeg',
      'image2.jpeg'
    ];

    let currentGalleryIdx = 0;

    const flipImg = document.getElementById('flipImg');
    const flipCount = document.getElementById('flipCount');
    const nextBtn = document.getElementById('nextPhoto');
    const prevBtn = document.getElementById('prevPhoto');

    function updateGallery(newIndex) {
      if (!flipImg) return;

      // Trigger flip animation
      flipImg.classList.add('turning');

      setTimeout(() => {
        currentGalleryIdx = newIndex;
        flipImg.src = galleryImages[currentGalleryIdx];

        if (flipCount) {
          flipCount.textContent = `${currentGalleryIdx + 1} / ${galleryImages.length}`;
        }

        flipImg.classList.remove('turning');
      }, 250);
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        const nextIdx = (currentGalleryIdx + 1) % galleryImages.length;
        updateGallery(nextIdx);
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        const prevIdx = (currentGalleryIdx - 1 + galleryImages.length) % galleryImages.length;
        updateGallery(prevIdx);
      });
    }

  </script>

  <!-- ========================================================
       LUXURY WEDDING POPUP DIALOGS (CONFIRM, SUCCESS & NOTICE)
  ======================================================== -->
  <div class="wedding-modal-overlay" id="weddingModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <div class="wedding-modal-card">
      <button class="modal-close-btn" id="modalCloseBtn" type="button" aria-label="Close dialog">&times;</button>
      <div class="celebrate-sparkles" id="modalSparkles"></div>

      <div class="modal-icon-badge" id="modalIconBadge">
        <!-- Dynamic icon inserted here -->
      </div>

      <h3 class="modal-title" id="modalTitle">Confirm Your Wishes</h3>
      <div class="modal-script" id="modalScript">Theres &amp; Midhun</div>
      <p class="modal-desc" id="modalDesc">Please review your message before sending.</p>

      <div class="modal-preview-box" id="modalPreviewBox" style="display: none;">
        <div class="modal-preview-label">Your Message Preview</div>
        <div class="modal-preview-name" id="modalPreviewName"></div>
        <div class="modal-preview-msg" id="modalPreviewMsg"></div>
      </div>

      <div class="modal-actions" id="modalActions">
        <!-- Injected dynamically -->
      </div>
    </div>
  </div>

  <script>
    /* ========================================================
       STYLISH POPUP MODALS & WISH FORM SUBMISSION LOGIC
    ======================================================== */
    (function initWeddingModals() {
      const weddingModal = document.getElementById('weddingModal');
      const modalCloseBtn = document.getElementById('modalCloseBtn');
      const modalIconBadge = document.getElementById('modalIconBadge');
      const modalTitle = document.getElementById('modalTitle');
      const modalScript = document.getElementById('modalScript');
      const modalDesc = document.getElementById('modalDesc');
      const modalPreviewBox = document.getElementById('modalPreviewBox');
      const modalPreviewName = document.getElementById('modalPreviewName');
      const modalPreviewMsg = document.getElementById('modalPreviewMsg');
      const modalActions = document.getElementById('modalActions');
      const modalSparkles = document.getElementById('modalSparkles');

      const wishForm = document.getElementById('wishForm');
      const wishNameInput = document.getElementById('wishName');
      const wishTextInput = document.getElementById('wishText');
      const wishList = document.getElementById('wishList');

      if (!weddingModal) return;

      function openModal() {
        weddingModal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        weddingModal.classList.remove('active');
        document.body.style.overflow = '';
      }

      if (modalCloseBtn) {
        modalCloseBtn.addEventListener('click', closeModal);
      }

      weddingModal.addEventListener('click', (e) => {
        if (e.target === weddingModal) {
          closeModal();
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && weddingModal.classList.contains('active')) {
          closeModal();
        }
      });

      function escapeHtml(str) {
        const div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
      }

      function triggerCelebrationSparkles() {
        if (!modalSparkles) return;
        modalSparkles.innerHTML = '';
        const colors = ['#C6A15B', '#deb872', '#7FA8C9', '#E7CFC1', '#FFD700'];
        for (let i = 0; i < 24; i++) {
          const spark = document.createElement('span');
          spark.className = 'sparkle-dot';
          const size = Math.floor(Math.random() * 7 + 4);
          spark.style.width = size + 'px';
          spark.style.height = size + 'px';
          spark.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
          spark.style.left = '50%';
          spark.style.top = '50%';
          const angle = Math.random() * 2 * Math.PI;
          const dist = Math.random() * 160 + 60;
          const tx = Math.cos(angle) * dist + 'px';
          const ty = Math.sin(angle) * dist + 'px';
          spark.style.setProperty('--tx', tx);
          spark.style.setProperty('--ty', ty);
          spark.style.animationDelay = (Math.random() * 0.2) + 's';
          modalSparkles.appendChild(spark);
        }
      }

      // 1. CONFIRMATION POPUP MODAL
      function showConfirmDialog(name, message, onConfirmCallback) {
        modalIconBadge.className = 'modal-icon-badge';
        modalIconBadge.innerHTML = `
          <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="color: var(--gold);">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
        `;
        modalTitle.textContent = "Confirm Your Wishes";
        modalScript.textContent = "Theres & Midhun's Celebration";
        modalDesc.textContent = "Would you like to send this heartfelt blessing to the bride and groom?";

        modalPreviewBox.style.display = 'block';
        modalPreviewName.textContent = name;
        modalPreviewMsg.textContent = `“${message}”`;

        modalActions.innerHTML = `
          <button type="button" class="modal-btn modal-btn-cancel" id="modalCancelBtn">Edit Message</button>
          <button type="button" class="modal-btn modal-btn-primary" id="modalConfirmBtn">Yes, Send Wishes 💌</button>
        `;

        document.getElementById('modalCancelBtn').addEventListener('click', closeModal);
        document.getElementById('modalConfirmBtn').addEventListener('click', () => {
          const btn = document.getElementById('modalConfirmBtn');
          btn.disabled = true;
          btn.textContent = "Sending with love...";
          onConfirmCallback();
        });

        openModal();
      }

      // 2. SUCCESS CELEBRATION POPUP MODAL
      function showSuccessDialog(name) {
        modalIconBadge.className = 'modal-icon-badge success-badge';
        modalIconBadge.innerHTML = `
          <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--gold);">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
        `;
        modalTitle.textContent = "Warmest Thanks!";
        modalScript.textContent = "Theres & Midhun";
        modalDesc.innerHTML = `Dear <strong>${escapeHtml(name)}</strong>, your lovely wishes and blessings have been warmly received. Thank you for celebrating this joy with us! ✨`;

        modalPreviewBox.style.display = 'none';

        modalActions.innerHTML = `
          <button type="button" class="modal-btn modal-btn-primary" id="modalSuccessCloseBtn">Celebrate &amp; View 🥂</button>
        `;

        document.getElementById('modalSuccessCloseBtn').addEventListener('click', closeModal);

        triggerCelebrationSparkles();
        openModal();
      }

      // 3. NOTICE / GENTLE ALERT POPUP MODAL
      function showNoticeDialog(title, message) {
        modalIconBadge.className = 'modal-icon-badge';
        modalIconBadge.innerHTML = `
          <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--gold);">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
        `;
        modalTitle.textContent = title;
        modalScript.textContent = "Theres & Midhun";
        modalDesc.textContent = message;
        modalPreviewBox.style.display = 'none';

        modalActions.innerHTML = `
          <button type="button" class="modal-btn modal-btn-primary" id="modalNoticeCloseBtn">Understood</button>
        `;

        document.getElementById('modalNoticeCloseBtn').addEventListener('click', closeModal);
        openModal();
      }

      // ATTACH TO WISH FORM
      if (wishForm) {
        wishForm.addEventListener('submit', (e) => {
          e.preventDefault();

          const name = (wishNameInput ? wishNameInput.value : '').trim();
          const message = (wishTextInput ? wishTextInput.value : '').trim();

          if (!name) {
            showNoticeDialog("Please enter your name", "We would love to know who is sharing this blessing!");
            if (wishNameInput) wishNameInput.focus();
            return;
          }

          if (!message) {
            showNoticeDialog("Please enter your wishes", "Please write a heartfelt message or blessing before submitting.");
            if (wishTextInput) wishTextInput.focus();
            return;
          }

          // Show the gorgeous confirmation modal
          showConfirmDialog(name, message, async () => {
            try {
              // 1. Submit form silently via target iframe to prevent any navigation/redirect
              wishForm.submit();

              // 2. Also dispatch fetch in no-cors mode for extra reliability
              try {
                const formData = new FormData(wishForm);
                fetch(wishForm.action, {
                  method: 'POST',
                  mode: 'no-cors',
                  body: formData
                }).catch(() => { });
              } catch (_) { }

              // 3. Render card dynamically to list
              if (wishList) {
                const card = document.createElement('div');
                card.className = 'wish-card';
                card.style.opacity = '0';
                card.style.transform = 'translateY(12px)';
                card.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
                card.innerHTML = `
                  <div class="w-name">${escapeHtml(name)}</div>
                  <div class="w-msg">${escapeHtml(message)}</div>
                `;
                wishList.prepend(card);
                requestAnimationFrame(() => {
                  card.style.opacity = '1';
                  card.style.transform = 'translateY(0)';
                });
              }

              // 4. Reset form inputs
              wishForm.reset();

              // 5. Show celebratory success popup!
              showSuccessDialog(name);
            } catch (err) {
              console.error("Error during wish submission:", err);
              showSuccessDialog(name);
            }
          });
        });
      }
    })();
  </script>
</body>

</html>
