        min-height: 100svh;
        padding: 112px 18px 72px
      }

      #home::after {
        inset: 10px
      }

      .hero-inner {
        padding: 32px 18px
      }

      .hero-inner .eyebrow {
        margin-bottom: 15px;
        letter-spacing: .23em
      }

      .hero-names {
        font-size: clamp(3.2rem, 14vw, 4.6rem);
        line-height: 1.18;
        letter-spacing: 0.01em;
      }

      .hero-cta {
        margin-top: 25px;
        padding: 14px 27px
      }

      .scroll-cue {
        bottom: 18px
      }

      .section {
        padding: 72px 20px
      }

      .section-head {
        margin-bottom: 36px
      }

      .section-head h2 {
        font-size: 2.35rem
      }

      .section-branch {
        width: 150px;
        height: 150px;
        opacity: .45
      }

      .countdown {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 11px
      }

      .count-box {
        width: auto;
        padding: 16px 6px
      }

      .photo-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 12px
      }

      .photo-grid .ph:nth-child(2) {
        margin-top: 22px
      }

      .photo-grid .ph:nth-child(4) {
        margin-top: -22px
      }

      .story-grid,
      .family-cols {
        grid-template-columns: 1fr;
        gap: 28px
      }

      .story-img-wrapper {
        max-width: 440px;
        margin: auto
      }

      .insta-reels-container {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px
      }

      .insta-card {
        border-width: 2px;
        border-radius: 14px
      }

      .insta-badge,
      .insta-sound-btn {
        display: none
      }

      .insta-title {
        font-size: 10px;
        left: 9px;
        right: 9px;
        bottom: 10px
      }

      .roadmap-container {
        padding: 0;
        margin-top: 20px
      }

      .roadmap-line-bg {
        left: 29px;
        top: 28px;
        bottom: 28px;
        right: auto;
        width: 2px;
        height: auto
      }

      .roadmap-line-progress {
        width: 100% !important;
        height: 0;
        transition: height 1.2s var(--ease)
      }

      .roadmap {
        display: flex;
        flex-direction: column;
        gap: 0
      }

      .rm-step {
        display: grid;
        grid-template-columns: 58px 1fr;
        text-align: left;
        gap: 15px;
        padding: 0 0 28px
      }

      .rm-num {
        width: 58px;
        height: 58px;
        margin: 0
      }

      .rm-step-content {
        padding-top: 4px
      }

      .rm-step p {
        margin: 0;
        padding: 0;
        max-width: none
      }

      .family-card {
        padding: 26px 20px
      }

      .member {
        gap: 12px
      }

      .location-card {
        padding: 16px
      }

      .location-actions {
        align-items: flex-start;
        gap: 14px
      }

      .qr-image {
        width: 82px;
        height: 82px
      }

      .link-box p {
        font-size: .78rem
      }

      .map-btn {
        padding: 10px 12px;
        font-size: .75rem
      }

      .music-player-btn {
        right: 15px;
        bottom: 15px;
        width: 52px;
        height: 52px
      }
    }

    @media (prefers-reduced-motion:reduce) {

      *,
      *::before,
      *::after {
        scroll-behavior: auto !important;
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important
      }

      .reveal {
        opacity: 1;
        transform: none
      }
    }

    /* ========================================================
       STYLISH WEDDING MODAL & POPUP DIALOGS
    ======================================================== */
    .wedding-modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(18, 32, 45, 0.65);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      z-index: 3000;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.35s ease;
    }

    .wedding-modal-overlay.active {
      opacity: 1;
      visibility: visible;
    }

    .wedding-modal-card {
      position: relative;
      width: 100%;
      max-width: 480px;
      background: linear-gradient(155deg, #FFFFFF 0%, #FAF7F0 55%, #F4ECE0 100%);
      border: 1px solid rgba(198, 161, 91, 0.45);
      border-radius: 24px;
      padding: 38px 30px 32px;
      box-shadow: 0 25px 65px -15px rgba(22, 38, 51, 0.45), 0 0 40px rgba(198, 161, 91, 0.2);
      text-align: center;
      transform: scale(0.92) translateY(24px);
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      overflow: hidden;
    }

    .wedding-modal-overlay.active .wedding-modal-card {
      transform: scale(1) translateY(0);
    }

    .wedding-modal-card::before,
    .wedding-modal-card::after {
      content: '';
      position: absolute;
      width: 44px;
      height: 44px;
      pointer-events: none;
      border-color: rgba(198, 161, 91, 0.35);
      border-style: solid;
    }

    .wedding-modal-card::before {
      top: 12px;
      left: 12px;
      border-width: 1px 0 0 1px;
      border-top-left-radius: 14px;
    }

    .wedding-modal-card::after {
      bottom: 12px;
      right: 12px;
      border-width: 0 1px 1px 0;
      border-bottom-right-radius: 14px;
    }

    .modal-close-btn {
      position: absolute;
      top: 14px;
      right: 14px;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      border: 1px solid rgba(198, 161, 91, 0.3);
      background: rgba(255, 255, 255, 0.8);
      color: var(--ink-soft);
      font-size: 1.3rem;
      line-height: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.25s ease;
      z-index: 5;
    }

    .modal-close-btn:hover {
      background: var(--gold);
      color: #fff;
      border-color: var(--gold);
      transform: rotate(90deg);
    }

    .modal-icon-badge {
      width: 72px;
      height: 72px;
      margin: 0 auto 16px;
      border-radius: 50%;
      background: linear-gradient(135deg, #FFFDF8 0%, #F5E5C7 100%);
      border: 2px solid var(--gold);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 8px 24px -5px rgba(198, 161, 91, 0.45);
      position: relative;
    }

    .modal-icon-badge.success-badge {
      animation: modalPulseRing 2.2s infinite;
    }

    @keyframes modalPulseRing {
      0% {
        box-shadow: 0 0 0 0 rgba(198, 161, 91, 0.55);
      }

      70% {
        box-shadow: 0 0 0 16px rgba(198, 161, 91, 0);
      }

      100% {
        box-shadow: 0 0 0 0 rgba(198, 161, 91, 0);
      }
    }

    .modal-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.5rem;
      color: var(--ink);
      margin-bottom: 2px;
      font-weight: 600;
    }

    .modal-script {
      font-family: 'Marck Script', cursive;
      font-size: 1.35rem;
      color: var(--gold);
      margin-bottom: 12px;
    }

    .modal-desc {
      font-family: 'Jost', sans-serif;
      font-size: 0.95rem;
      color: var(--ink-soft);
      line-height: 1.6;
      margin-bottom: 18px;
    }

    .modal-preview-box {
      background: rgba(231, 241, 247, 0.6);
      border: 1px dashed rgba(127, 168, 201, 0.7);
      border-radius: 14px;
      padding: 14px 18px;
      margin: 16px 0 20px;
      text-align: left;
    }

    .modal-preview-label {
      font-size: 0.72rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--powder-deep);
      font-weight: 600;
      margin-bottom: 4px;
    }

    .modal-preview-name {
      font-family: 'Playfair Display', serif;
      font-size: 1.05rem;
      color: var(--ink);
      font-weight: 600;
      margin-bottom: 6px;
    }

    .modal-preview-msg {
      font-family: 'Jost', sans-serif;
      font-size: 0.92rem;
      color: var(--ink-soft);
      font-style: italic;
      max-height: 90px;
      overflow-y: auto;
      word-break: break-word;
      padding-left: 10px;
      border-left: 2px solid var(--gold);
    }

    .modal-actions {
      display: flex;
      gap: 12px;
      justify-content: center;
      align-items: center;
      margin-top: 8px;
      flex-wrap: wrap;
    }

    .modal-btn {
      font-family: 'Jost', sans-serif;
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 12px 26px;
      border-radius: 999px;
      cursor: pointer;
      transition: all 0.25s ease;
      border: none;
      outline: none;
    }

    .modal-btn-cancel {
      background: rgba(255, 255, 255, 0.85);
      border: 1px solid var(--powder);
      color: var(--ink-soft);
    }

    .modal-btn-cancel:hover {
      background: var(--powder-pale);
      color: var(--ink);
    }

    .modal-btn-primary {
      background: linear-gradient(135deg, #C6A15B 0%, #b89146 100%);
      color: #ffffff;
      box-shadow: 0 8px 20px -6px rgba(198, 161, 91, 0.6);
    }

    .modal-btn-primary:hover {
      background: linear-gradient(135deg, #d4ae67 0%, #c6a15b 100%);
      transform: translateY(-2px);
      box-shadow: 0 12px 24px -6px rgba(198, 161, 91, 0.7);
    }

    .modal-btn-primary:active {
      transform: translateY(0);
    }

    .modal-btn-primary:disabled {
      opacity: 0.65;
      cursor: not-allowed;
      transform: none;
    }

    .celebrate-sparkles {
      position: absolute;
      inset: 0;
      pointer-events: none;
      overflow: hidden;
    }

    .sparkle-dot {
      position: absolute;
      border-radius: 50%;
      background: var(--gold);
      opacity: 0;
      animation: sparkleFly 1.8s ease-out forwards;
    }

    @keyframes sparkleFly {
      0% {
        transform: translate(0, 0) scale(0);
        opacity: 1;
      }

      100% {
        transform: translate(var(--tx), var(--ty)) scale(1.4);
        opacity: 0;
      }
    }
  </style>
</head>

<body>

  <header class="nav" id="siteNav">
    <div class="nav-mark">T &amp; M</div>
    <ul class="nav-links" id="navLinks">
      <li><a href="#home">Home</a></li>
      <li><a href="#save-the-date">Save the Date</a></li>
      <li><a href="#location">Location</a></li>
      <li><a href="#journey">Journey</a></li>
      <li><a href="#family">Family</a></li>
      <li><a href="#wishes">Wishes</a></li>
      <li><a href="#gallery">Gallery</a></li>
    </ul>
  </header>

  <nav class="dot-nav" id="dotNav">
    <a href="#home"><span class="tip">Home</span></a>
    <a href="#save-the-date"><span class="tip">Save the Date</span></a>
    <a href="#engagement"><span class="tip">Engagement</span></a>
    <a href="#story"><span class="tip">Our Story</span></a>
    <a href="#videos"><span class="tip">Videos</span></a>
    <a href="#journey"><span class="tip">Journey</span></a>
    <a href="#family"><span class="tip">Family</span></a>
    <a href="#wishes"><span class="tip">Wishes</span></a>
    <a href="#location"><span class="tip">Location</span></a>
    <a href="#gallery"><span class="tip">Gallery</span></a>
  </nav>

  <section id="home">
    <div class="shimmer-field" id="shimmerField"></div>
    <div class="hero-inner">
      <div class="hero-monogram-badge">
        <svg class="hero-crest-svg" viewBox="0 0 120 28" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M4 14 C 20 14, 28 6, 44 14 C 50 17, 54 17, 60 14 C 66 11, 70 11, 76 14 C 92 22, 100 14, 116 14"
            stroke="#C6A15B" stroke-width="1.2" stroke-linecap="round" />
          <circle cx="60" cy="14" r="3" fill="#C6A15B" />
          <path d="M52 14 C50 8, 56 8, 54 14" stroke="#C6A15B" stroke-width="0.9" fill="none" />
          <path d="M68 14 C66 8, 72 8, 70 14" stroke="#C6A15B" stroke-width="0.9" fill="none" />
        </svg>
      </div>
      <span class="eyebrow">The Wedding Celebration</span>
      <h1 class="hero-names">
        <span class="hero-name-item hero-name-theres">Theres</span>
        <span class="hero-amp-container">
          <span class="hero-amp">&amp;</span>
        </span>
        <span class="hero-name-item hero-name-midhun">Midhun</span>
      </h1>
      <div class="hero-tagline-container">
        <span class="tagline-ornament"></span>
        <p class="hero-tagline">Are getting married</p>
        <span class="tagline-ornament"></span>
      </div>
      <div class="hero-date-block">
        <div class="hero-date-big">November 21, 2026</div>
        <div class="hero-venue">St. Mary's Forane Church • Alakode, Kannur</div>
      </div>
      <a href="#journey" class="hero-cta">View Schedule</a>
    </div>
    <div class="hero-scene" role="img" aria-label="Watercolor illustration of the couple"></div>
    <div class="scroll-cue"><span>Scroll</span><span class="line"></span></div>
  </section>

  <section class="section" id="save-the-date">
    <div class="section-branch left"></div>
    <div class="section-branch right"></div>
    <div class="section-head reveal">
      <span class="eyebrow">The Wedding</span>
      <p>CEREMONY</p>
      <span class="eyebrow">10 AM</span>
      <p>St. Mary's Forane Church, Alakode</p>
      <p>The countdown has begun — join us as we begin our forever.</p>
    </div>
    <div class="countdown reveal" id="countdown">
      <div class="count-box">
        <div class="num" id="cd-days">00</div>
        <div class="lbl">Days</div>
      </div>
      <div class="count-box">
        <div class="num" id="cd-hours">00</div>
        <div class="lbl">Hours</div>
      </div>
      <div class="count-box">
        <div class="num" id="cd-mins">00</div>
        <div class="lbl">Minutes</div>
      </div>
      <div class="count-box">
        <div class="num" id="cd-secs">00</div>
        <div class="lbl">Seconds</div>
      </div>
    </div>
    <div class="photo-grid reveal">
      <div class="ph" data-full="https://picsum.photos/seed/std1/900/1200"><img src="pic1.jpeg" alt="The couple"
          loading="lazy">
        <div class="cap">The Announcement</div>
      </div>
      <div class="ph" data-full="https://picsum.photos/seed/std2/900/1200"><img src="pic2.jpeg" alt="Golden hour"
          loading="lazy">
        <div class="cap">Golden Hour</div>
      </div>
      <div class="ph" data-full="https://picsum.photos/seed/std3/900/1200"><img src="pic3.jpeg" alt="Holding hands"
          loading="lazy">
        <div class="cap">Hand in Hand</div>
      </div>
      <div class="ph" data-full="https://picsum.photos/seed/std4/900/1200"><img src="pic4.jpeg" alt="Us" loading="lazy">
        <div class="cap">Us, Always</div>
      </div>
    </div>
  </section>

  <div class="wave"><svg viewBox="0 0 1440 70" preserveAspectRatio="none">
      <path d="M0,30 C400,80 1040,-10 1440,30 L1440,70 L0,70 Z" fill="#E7F1F7"></path>
    </svg></div>

  <section class="section" id="galleryus">
    <div class="section-head reveal">
      <span class="eyebrow">Beginning of Forever</span>
      <h2>Two Hearts, One Journey</h2>
    </div>
    <div class="story-grid reveal">
      <div class="story-img-wrapper">
        <img src="image3.jpeg" alt="Theres and Midhun">
      </div>
      <div class="story-text">
        <h4>"It is not built of grand designs,<br>

          nor finished on the day we vow,<br>

          but in the quiet, patient lines<br>

          of choosing us, forever now—<br>

          a roof against the wind and stone,<br>

          two souls who never walk alone."</h3>
      </div>
    </div>
  </section>

  <section class="section" id="videos">
    <div class="section-branch left"></div>
    <div class="section-branch right"></div>
    <div class="section-head reveal">
      <span class="eyebrow">For our loved ones</span>
      <h2>Exclusive Videos</h2>
      <p>A few moments we've captured along the way — tap to watch.</p>
    </div>
    <div class="insta-reels-container reveal">
      <div class="insta-card" data-title="The Proposal" onclick="openReelModal('video1.mp4', 'The Proposal')">
        <video src="video1.mp4" preload="metadata" autoplay muted loop playsinline></video>
        <div class="insta-overlay"></div>
        <span class="insta-badge">Exclusive</span>
        <button class="insta-sound-btn" onclick="toggleSound(event, this)">
          <svg class="sound-icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2"
            fill="none">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <line x1="23" y1="9" x2="17" y2="15"></line>
            <line x1="17" y1="9" x2="23" y2="15"></line>
          </svg>
        </button>
        <div class="insta-title">The Proposal</div>
      </div>

      <div class="insta-card" data-title="Our Journey" onclick="openReelModal('video2.mp4', 'Our Journey')">
        <video src="video2.mp4" preload="metadata" autoplay muted loop playsinline></video>
        <div class="insta-overlay"></div>
        <span class="insta-badge">Exclusive</span>
        <button class="insta-sound-btn" onclick="toggleSound(event, this)">
          <svg class="sound-icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2"
            fill="none">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <line x1="23" y1="9" x2="17" y2="15"></line>
            <line x1="17" y1="9" x2="23" y2="15"></line>
          </svg>
        </button>
        <div class="insta-title">Our Journey</div>
      </div>

      <div class="insta-card" data-title="Special Memories" onclick="openReelModal('video3.mp4', 'Special Memories')">
        <video src="video3.mp4" preload="metadata" autoplay muted loop playsinline></video>
        <div class="insta-overlay"></div>
        <span class="insta-badge">Exclusive</span>
        <button class="insta-sound-btn" onclick="toggleSound(event, this)">
          <svg class="sound-icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2"
            fill="none">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <line x1="23" y1="9" x2="17" y2="15"></line>
            <line x1="17" y1="9" x2="23" y2="15"></line>
          </svg>
        </button>
        <div class="insta-title">Special Memories</div>
      </div>
    </div>

    <div id="reelModal" class="insta-modal" onclick="closeReelModal()">
      <div class="insta-modal-content" onclick="event.stopPropagation()">
        <span class="insta-close-btn" onclick="closeReelModal()">&times;</span>
        <video id="modalVideo" controls autoplay playsinline></video>
        <h3 id="modalTitle"></h3>
      </div>
    </div>
  </section>

  <section class="section" id="journey">
    <div class="section-branch left"></div>
    <div class="section-branch right"></div>
    <div class="section-head reveal">
      <span class="eyebrow">The celebration</span>
      <h2>Our Journey</h2>
      <p>Five milestones, one beautiful road to forever.</p>
    </div>
    <div class="roadmap-container reveal">
      <div class="roadmap-line-bg">
        <div class="roadmap-line-progress" id="roadmapProgress"></div>
      </div>
      <div class="roadmap" id="roadmap">
        <div class="rm-step" data-date="2026-03-21">
          <div class="rm-num">01</div>
          <div class="rm-step-content">
            <h3>Fixation</h3>
            <p>Families formalize alliance.</p>
          </div>
        </div>
        <div class="rm-step" data-date="2026-11-16">
          <div class="rm-num">02</div>
          <div class="rm-step-content">
            <h3>Engagement</h3>
            <div class="rm-date">16 Nov 2026</div>
            <p>A beautiful "Yes"</p>
          </div>
        </div>
        <div class="rm-step" data-date="2026-11-21">
          <div class="rm-num">03</div>
          <div class="rm-step-content">
            <h3>Marriage</h3>
            <div class="rm-date">21 Nov 2026</div>
            <p>Becoming one.</p>
          </div>
        </div>
        <div class="rm-step" data-date="2026-11-21">
          <div class="rm-num">04</div>
          <div class="rm-step-content">
            <h3>Reception</h3>
            <div class="rm-date">21 Nov 2026</div>
            <p>Grand celebration.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="family">
    <div class="section-branch left"></div>
    <div class="section-branch right"></div>
    <div class="section-head reveal">
      <span class="eyebrow">With love and gratitude</span>
      <h2>Family Details</h2>
    </div>
    <div class="family-cols reveal">
      <div class="family-card">
        <h3>Groom's Family</h3>
        <span class="eyebrow sub">Midhun</span>
        <div class="member">
          <div class="avatar"></div>
          <div>
            <div class="m-name">Mr. George Devasia</div>
            <div class="m-rel">Father</div>
          </div>
        </div>
        <div class="member">
          <div class="avatar"></div>
          <div>
            <div class="m-name">Mrs. Shanty George</div>
            <div class="m-rel">Mother</div>
          </div>
        </div>
        <div class="member">
          <div class="avatar"></div>
          <div>
            <div class="m-name">Mr. Jithin &amp; Mrs. Mariya</div>
            <div class="m-rel">Brother &amp; Sister-in-law</div>
          </div>
        </div>
        <div class="member">
          <div class="avatar"></div>
          <div>
            <div class="m-name">Mr. Athul George</div>
            <div class="m-rel">Brother</div>
          </div>
        </div>
      </div>
      <div class="family-card">
        <h3>Bride's Family</h3>
        <span class="eyebrow sub">Theres</span>
        <div class="member">
          <div class="avatar"></div>
